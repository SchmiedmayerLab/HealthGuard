    n15 [label="n15: Her C-peptide level was 9.9 ng/mL.\\n[statistical]", fillcolor="#c8e6c9"];
    n16 [label="n16: Elevated C-peptide means the insulin is being secreted endogenously or stimulated endogenously rather than being purely injected exogenous insulin.\\n[causal]", fillcolor="#c8e6c9"];
