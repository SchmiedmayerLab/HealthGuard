    n1 [label="n1: The chief problem is recurrent symptomatic hypoglycemia in a 19-year-old woman.\\n[factual]", fillcolor="#c8e6c9"];
    n2 [label="n2: Her symptoms progressed from lightheadedness and weakness to repeated episodes of unresponsiveness.\\n[factual]", fillcolor="#c8e6c9"];
    n3 [label="n3: Her symptom pattern is classic for neuroglycopenia and adrenergic activation.\\n[causal]", fillcolor="#c8e6c9"];
    n4 [label="n4: Her symptoms included diaphoresis, palpitations, confusion, weakness, and altered mental status.\\n[factual]", fillcolor="#c8e6c9"];
    n5 [label="n5: Her documented glucose values were 53 mg/dL at home, 60 mg/dL in the ED, 46 mg/dL prehospital, and as low as 23 mg/dL on the third visit.\\n[statistical]", fillcolor="#c8e6c9"];
    n6 [label="n6: This fulfills Whipple-type concern.\\n[factual]", fillcolor="#c8e6c9"];
    n7 [label="n7: The Whipple-type concern includes symptoms consistent with hypoglycemia.\\n[factual]", fillcolor="#c8e6c9"];
    n8 [label="n8: The Whipple-type concern includes low measured glucose.\\n[factual]", fillcolor="#c8e6c9"];
