digraph ReasoningGraph {
  rankdir="LR";
  compound=true;
  node [shape=box, style="rounded,filled"];
  subgraph cluster_0 {
    label="history_taking (c1)";
    style="rounded,dashed";
    color="#9e9e9e";
    n1 [label="n1: The chief concern is recurrent postoperative episodes of right knee rash, warmth, swelling, stiffness, and severe throbbing pain after patellofemoral arthroplasty/MPFL reconstruction.\\n[factual]", fillcolor="#c8e6c9"];
    n2 [label="n2: The initial clinical concern was infection.\\n[factual]", fillcolor="#c8e6c9"];
    n3 [label="n3: The initial concern was based on symptoms that began 4 weeks after surgery with erythema, warmth, swelling, and limited range of motion.\\n[causal]", fillcolor="#c8e6c9"];
    n4 [label="n4: The patient continued to have recurrent episodic symptoms despite a negative infectious and vascular workup.\\n[factual]", fillcolor="#c8e6c9"];
    n5 [label="n5: She developed an erythematous blanchable rash around the incision at 4 weeks post-op.\\n[factual]", fillcolor="#c8e6c9"];
    n6 [label="n6: The rash was later described as persistent with mild urticaria and warmth.\\n[factual]", fillcolor="#c8e6c9"];
    n7 [label="n7: Over weeks 7 to 21, she had recurrent knee warmth.\\n[statistical]", fillcolor="#c8e6c9"];
    n8 [label="n8: Over weeks 7 to 21, she had recurrent knee swelling.\\n[statistical]", fillcolor="#c8e6c9"];
    n9 [label="n9: Over weeks 7 to 21, she had a reticular rash over the limb.\\n[statistical]", fillcolor="#c8e6c9"];
    n10 [label="n10: Over weeks 7 to 21, she had severe activity-related throbbing pain up to 10/10.\\n[statistical]", fillcolor="#c8e6c9"];
    n11 [label="n11: There was trace effusion.\\n[factual]", fillcolor="#c8e6c9"];
    n12 [label="n12: There was joint-line tenderness.\\n[factual]", fillcolor="#c8e6c9"];
    n13 [label="n13: The incision sites were well healed.\\n[factual]", fillcolor="#c8e6c9"];
    n14 [label="n14: Symptoms subjectively improved after diphenhydramine in the emergency department.\\n[causal]", fillcolor="#c8e6c9"];
    n15 [label="n15: She reported intermittent bloating.\\n[factual]", fillcolor="#c8e6c9"];
    n16 [label="n16: She reported intermittent fatigue.\\n[factual]", fillcolor="#c8e6c9"];
    n17 [label="n17: She reported intermittent headaches.\\n[factual]", fillcolor="#c8e6c9"];
    n18 [label="n18: She was afebrile.\\n[factual]", fillcolor="#c8e6c9"];
    n19 [label="n19: Her vital signs were normal.\\n[factual]", fillcolor="#c8e6c9"];
  }
  subgraph cluster_1 {
    label="test_ordering (c2)";
    style="rounded,dashed";
    color="#9e9e9e";
    n20 [label="n20: Laboratory inflammatory markers were normal.\\n[factual]", fillcolor="#c8e6c9"];
    n21 [label="n21: MRI showed no evidence of infection.\\n[factual]", fillcolor="#c8e6c9"];
    n22 [label="n22: Repeated workup for infection and thromboembolism was negative.\\n[factual]", fillcolor="#c8e6c9"];
    n23 [label="n23: Patch testing for implant allergy was negative.\\n[factual]", fillcolor="#c8e6c9"];
    n24 [label="n24: Serum tryptase was normal.\\n[factual]", fillcolor="#c8e6c9"];
    n25 [label="n25: Serum C4 was normal.\\n[factual]", fillcolor="#c8e6c9"];
    n26 [label="n26: MRI angiography showed patent vasculature.\\n[factual]", fillcolor="#c8e6c9"];
    n27 [label="n27: Abdominopelvic CT showed patent vasculature.\\n[factual]", fillcolor="#c8e6c9"];
    n28 [label="n28: The surgical wounds were well healed.\\n[factual]", fillcolor="#c8e6c9"];
  }
  subgraph cluster_2 {
    label="differential_generation (c3)";
    style="rounded,dashed";
    color="#9e9e9e";
    n29 [label="n29: Periprosthetic joint infection or postoperative cellulitis initially fits because of postoperative erythema, warmth, swelling, pain, and stiffness.\\n[causal]", fillcolor="#c8e6c9"];
    n30 [label="n30: Periprosthetic joint infection or postoperative cellulitis becomes less likely given afebrile status, normal vitals, normal inflammatory markers, MRI without infection, well-healed incisions, and a recurrent episodic pattern over many weeks despite antibiotics.\\n[causal]", fillcolor="#c8e6c9"];
    n31 [label="n31: Implant hypersensitivity or contact allergy is plausible because symptoms are localized around the operative site with rash and swelling after arthroplasty.\\n[causal]", fillcolor="#c8e6c9"];
    n32 [label="n32: Patch testing was negative.\\n[factual]", fillcolor="#c8e6c9"];
    n33 [label="n33: The associated intermittent bloating, fatigue, and headaches suggest a broader trigger rather than an isolated implant reaction.\\n[causal]", fillcolor="#c8e6c9"];
    n34 [label="n34: A mast cell-mediated disorder such as mastocytosis or hereditary angioedema was considered because of urticaria-like rash and swelling.\\n[causal]", fillcolor="#c8e6c9"];
    n35 [label="n35: Normal tryptase and C4 make mastocytosis and hereditary angioedema less likely.\\n[causal]", fillcolor="#c8e6c9"];
    n36 [label="n36: Vascular causes such as DVT, May-Thurner syndrome, or popliteal entrapment could explain swelling and pain.\\n[causal]", fillcolor="#c8e6c9"];
    n37 [label="n37: Vascular imaging and thromboembolism workup were negative.\\n[factual]", fillcolor="#c8e6c9"];
    n38 [label="n38: The rash and urticaria pattern is not well explained by vascular causes.\\n[causal]", fillcolor="#c8e6c9"];
  }
  subgraph cluster_3 {
    label="differential_generation (c4)";
    style="rounded,dashed";
    color="#9e9e9e";
    n39 [label="n39: Alpha-gal syndrome best integrates the episodic nature, urticarial or blanchable rash, subjective response to antihistamine, and associated systemic symptoms of bloating, fatigue, and headaches.\\n[causal]", fillcolor="#c8e6c9"];
    n40 [label="n40: In the context of an orthopedic implant case, exposure to mammalian-derived surgical materials can trigger delayed allergic reactions in sensitized patients.\\n[causal]", fillcolor="#c8e6c9"];
    n41 [label="n41: Delayed allergic reactions in sensitized patients can produce recurrent local and systemic symptoms without infectious markers.\\n[causal]", fillcolor="#c8e6c9"];
    n42 [label="n42: The food diary recommendation from allergy specialists points toward suspicion for an exposure-triggered allergic syndrome.\\n[recommendation]", fillcolor="#c8e6c9"];
    n43 [label="n43: The repeated negative evaluations for infection, thrombosis, vascular compression, mastocytosis, hereditary angioedema, and implant contact allergy make those alternatives less convincing.\\n[causal]", fillcolor="#c8e6c9"];
    n44 [label="n44: The combination of recurrent urticarial or blanchable rash, warmth, swelling, severe pain episodes, antihistamine responsiveness, and gastrointestinal or systemic symptoms strongly supports an allergic syndrome with delayed mammalian-product sensitivity.\\n[causal]", fillcolor="#c8e6c9"];
  }
  subgraph cluster_4 {
    label="final_decision (c5)";
    style="rounded,dashed";
    color="#9e9e9e";
    n45 [label="n45: The single best diagnosis is alpha-gal syndrome presenting as postoperative hypersensitivity related to mammalian-derived surgical exposure.\\n[factual]", fillcolor="#c8e6c9"];
    n46 [label="n46: Periprosthetic joint infection or postoperative cellulitis was initially suggested by postoperative erythema, warmth, swelling, pain, stiffness, and trace effusion.\\n[causal]", fillcolor="#c8e6c9"];
    n47 [label="n47: Periprosthetic joint infection or postoperative cellulitis was undermined by afebrile status, normal inflammatory markers, well-healed incisions, and MRI negative for infection.\\n[causal]", fillcolor="#c8e6c9"];
    n48 [label="n48: Implant hypersensitivity was considered because localized recurrent rash, warmth, and swelling after arthroplasty could suggest implant allergy.\\n[causal]", fillcolor="#c8e6c9"];
    n49 [label="n49: Implant hypersensitivity was weakened by negative patch testing and systemic symptoms such as bloating, fatigue, and headaches.\\n[causal]", fillcolor="#c8e6c9"];
    n50 [label="n50: A mast cell-mediated allergic disorder such as mastocytosis was considered because mild urticaria, rash, swelling, and improvement after diphenhydramine were present.\\n[causal]", fillcolor="#c8e6c9"];
    n51 [label="n51: A mast cell-mediated allergic disorder was weakened by normal serum tryptase and episodes tied to the postoperative course rather than classic spontaneous mast cell activation.\\n[causal]", fillcolor="#c8e6c9"];
    n52 [label="n52: Hereditary angioedema was considered because swelling was present.\\n[causal]", fillcolor="#c8e6c9"];
    n53 [label="n53: Hereditary angioedema was weakened by normal C4 and the presence of an urticarial or blanchable rash.\\n[causal]", fillcolor="#c8e6c9"];
    n54 [label="n54: Alpha-gal syndrome was considered high because recurrent delayed episodes of rash or urticaria, warmth, swelling, severe pain, antihistamine response, and associated bloating, fatigue, and headaches after exposure to mammalian-derived surgical materials fit a delayed allergic syndrome consistent with alpha-gal sensitivity.\\n[causal]", fillcolor="#c8e6c9"];
    n55 [label="n55: The final diagnosis is alpha-gal syndrome.\\n[factual]", fillcolor="#c8e6c9"];
  }
  n3 -> n2 [label="supports: Symptoms starting 4 weeks after surgery with erythema, warmth, swelling, and limited ROM explain why infection was initially suspected."];
  n5 -> n3 [label="supports: The 4-week postoperative erythematous rash is part of the symptom pattern that triggered the initial infection concern."];
