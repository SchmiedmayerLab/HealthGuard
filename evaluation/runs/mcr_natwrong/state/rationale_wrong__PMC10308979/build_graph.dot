  n52 -> n53 [label="supports: Swelling alone is the basis for considering hereditary angioedema."];
  n53 -> n35 [label="supports: Normal C4 and urticarial/blanchable rash are the specific reasons hereditary angioedema is less likely."];
  n36 -> n38 [label="supports: Vascular causes are proposed as explanations for swelling and pain, but they do not explain the rash/urticaria pattern."];
  n37 -> n36 [label="supports: Negative vascular and thromboembolism workup weakens vascular causes."];
  n39 -> n54 [label="supports: This is the core diagnostic synthesis favoring alpha-gal syndrome."];
  n40 -> n54 [label="supports: Mammalian-derived surgical exposure provides the proposed trigger for alpha-gal sensitivity in this postoperative context."];
