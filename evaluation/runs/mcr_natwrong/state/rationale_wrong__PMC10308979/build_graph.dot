  n43 -> n54 [label="supports: Eliminating alternative diagnoses strengthens alpha-gal syndrome as the leading explanation."];
  n44 -> n54 [label="supports: This statement summarizes the clinical pattern that strongly supports delayed mammalian-product sensitivity."];
  n54 -> n55 [label="supports: The high suspicion for alpha-gal syndrome leads directly to the final diagnosis."];
  n1 -> n54 [label="supports: The recurrent postoperative rash, warmth, swelling, stiffness, and severe pain are the clinical pattern being explained by alpha-gal syndrome."];
