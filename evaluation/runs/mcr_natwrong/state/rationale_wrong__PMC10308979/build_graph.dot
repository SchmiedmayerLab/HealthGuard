  n46 -> n2 [label="supports: This restates the initial infectious impression based on postoperative inflammatory signs."];
  n47 -> n2 [label="supports: This restates the evidence against infection, supporting the shift away from that diagnosis."];
  n31 -> n48 [label="supports: The plausibility of implant hypersensitivity is the same reasoning later summarized in the more specific statement."];
  n32 -> n49 [label="supports: Negative patch testing is direct evidence weakening implant hypersensitivity."];
