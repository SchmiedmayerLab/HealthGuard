    n19 [label="n19: The dog had splenomegaly.\\n[factual]", fillcolor="#c8e6c9"];
    n20 [label="n20: These findings are classic features of babesiosis with hemolysis and platelet consumption or destruction.\\n[causal]", fillcolor="#c8e6c9"];
