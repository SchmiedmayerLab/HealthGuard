    n27 [label="n27: Ultrasound showed no effusions initially.\\n[factual]", fillcolor="#c8e6c9"];
    n28 [label="n28: Ultrasound showed no pulmonary B-lines initially.\\n[factual]", fillcolor="#c8e6c9"];
