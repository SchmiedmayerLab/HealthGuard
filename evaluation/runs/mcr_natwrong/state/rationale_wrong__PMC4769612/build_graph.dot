    n54 [label="n54: Meningioma more often causes sclerotic bony change.\\n[factual]", fillcolor="#c8e6c9"];
    n55 [label="n55: Meningioma more often causes a dural tail.\\n[factual]", fillcolor="#c8e6c9"];
