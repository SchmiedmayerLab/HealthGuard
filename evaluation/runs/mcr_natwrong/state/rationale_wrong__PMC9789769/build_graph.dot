    n5 [label="n5: Marked eosinophilia was present on the initial CBC.\\n[factual]", fillcolor="#c8e6c9"];
    n6 [label="n6: The eosinophilia measured 7.9 × 10^9/l.\\n[statistical]", fillcolor="#c8e6c9"];
    n7 [label="n7: Moderate basophilia was present on the initial CBC.\\n[factual]", fillcolor="#c8e6c9"];
