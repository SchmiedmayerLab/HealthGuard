  }
  subgraph cluster_3 {
    label="other (c4)";
    style="rounded,dashed";
    color="#9e9e9e";
    n25 [label="n25: The poor visualization of the left coronary artery appropriately raises concern for congenital coronary anomaly causing ischemia.\\n[causal]", fillcolor="#c8e6c9"];
    n26 [label="n26: The timing at day 6 is notable.\\n[factual]", fillcolor="#c8e6c9"];
    n27 [label="n27: Closure of fetal shunts/ductus can unmask duct-dependent lesions or alter coronary perfusion physiology.\\n[causal]", fillcolor="#c8e6c9"];
