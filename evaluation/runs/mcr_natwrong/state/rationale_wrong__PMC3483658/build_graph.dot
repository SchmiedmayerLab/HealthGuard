    n3 [label="n3: The newborn had sweating.\\n[factual]", fillcolor="#c8e6c9"];
    n4 [label="n4: The newborn had poor feeding/failure to thrive.\\n[factual]", fillcolor="#c8e6c9"];
    n5 [label="n5: The newborn had hypotension.\\n[factual]", fillcolor="#c8e6c9"];
    n6 [label="n6: The newborn had metabolic/lactic acidosis.\\n[factual]", fillcolor="#c8e6c9"];
    n7 [label="n7: The newborn had hepatomegaly.\\n[factual]", fillcolor="#c8e6c9"];
    n8 [label="n8: The newborn had weak femoral pulses.\\n[factual]", fillcolor="#c8e6c9"];
    n9 [label="n9: The newborn had evidence of heart failure.\\n[factual]", fillcolor="#c8e6c9"];
  }
  subgraph cluster_1 {
