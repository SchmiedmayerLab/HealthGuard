    n5 [label="n5: Empiric antifungal therapy failed.\\n[factual]", fillcolor="#c8e6c9"];
    n6 [label="n6: Topical corticosteroids worsened the eruption.\\n[factual]", fillcolor="#c8e6c9"];
    n7 [label="n7: The salient positive findings strongly point toward an infectious granulomatous dermatosis with neural involvement.\\n[causal]", fillcolor="#c8e6c9"];
    n8 [label="n8: He is chronically immunosuppressed after cadaveric renal transplant.\\n[factual]", fillcolor="#c8e6c9"];
